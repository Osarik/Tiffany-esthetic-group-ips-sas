# SMTP Configuration for Quejas y Reclamos
# Formulario: src/components/ui/complaint-form.tsx -> src/app/api/quejas
#
# Gmail requiere 2-Step Verification (2FA) activado en la cuenta.
# App Password: https://myaccount.google.com/apppasswords
#   App = "Otro (custom)". Google muestra la clave de 16 caracteres en
#   4 grupos de 4 y solo la muestra una vez. Guárdala SIN espacios.
# En Vercel: Project > Settings > Environment Variables, y redeploy
# despues de guardar (las funciones serverless se construyen con las
# variables del momento del build).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tiffanyestheticgroup@gmail.com
SMTP_PASS=your_app_password_here

# Email where complaints are sent
CONTACT_EMAIL=tiffanyestheticgroup@gmail.com
